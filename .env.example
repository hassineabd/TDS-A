# OpenRouter — single key for all providers (Anthropic, OpenAI, Google).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# BrowserStack credentials — only needed if you re-capture screenshots.
BROWSERSTACK_USERNAME=your_username
BROWSERSTACK_ACCESS_KEY=your_access_key

# Optional safety cap on benchmark.run (refuses to start above this).
MAX_CALLS=500
